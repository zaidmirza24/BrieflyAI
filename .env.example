# -- Transcription + diarization (Deepgram) --
# Free tier: $200 credit, no card required. https://console.deepgram.com/signup
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3

# Force a language instead of auto-detect (recommended for code-switched
# recordings -- auto-detect only looks at the first ~30s and can lock onto
# the wrong language for the whole file). Examples: ur, hi, en.
# WHISPER_LANGUAGE=ur

# -- LLM analysis (Gemini) --
# Free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LLM_MODEL=gemini-3.6-flash

# insights.json text values: "english" (default), "roman-urdu", or "roman-hindi"
# INSIGHTS_LANGUAGE=roman-urdu

# -- Web app (api/) --
# Login for the web interface (basic gate, no user accounts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# CORS_ORIGIN=http://localhost:5173
# MAX_UPLOAD_MB=500

# -- Audio staging (Backblaze B2 -- S3-compatible) --
# TEMPORARY storage only: the uploaded recording is deleted from B2 once its
# analysis is saved to MongoDB (or after CLEANUP_MAX_AGE_HOURS if abandoned).
# Create a free B2 bucket at https://www.backblaze.com/b2 -> Buckets, then an
# application key scoped to that bucket (Account -> Application Keys), and
# find your S3-compatible endpoint on the bucket's details page.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_ENDPOINT=
B2_BUCKET=insightder-audio-temp
# B2_UPLOAD_URL_TTL_SECONDS=3600

# -- MongoDB (permanent storage: students, mentors, sessions, insights) --
# Free cluster at https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=
# MONGODB_DB_NAME=insightder

# How old an abandoned/failed upload must be before the cleanup job deletes
# its B2 file (POST /api/maintenance/cleanup, run on an external schedule).
# CLEANUP_MAX_AGE_HOURS=24
